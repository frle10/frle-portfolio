---
import Icon from './Icon.astro';

type SkillData = {
  icon: 'terminal-window' | 'trophy' | 'heart';
  title: string;
  description: string;
  tools: string[];
};

const skillsData: SkillData[] = [
  {
    icon: 'terminal-window',
    title: 'Engineering<br>Depth',
    description:
      'From frontend polish to backend architecture — I’ve built across the stack with care, speed, and purpose.',
    tools: ['TypeScript', 'React', 'Node.js', 'Python', 'Go', 'PostgreSQL', 'Docker', 'AWS'],
  },
  {
    icon: 'trophy',
    title: 'Technical<br>Leadership',
    description:
      'I’ve mentored devs, shaped roadmaps, and scaled processes in fast-moving teams that tripled in size.',
    tools: ['Agile/Scrum', 'System Design', 'Code Reviews', 'CI/CD', 'Jira', 'Observability'],
  },
  {
    icon: 'heart',
    title: 'Human-Centered<br>Design',
    description:
      'I care about clarity — in interfaces, teams, and strategy. Good systems should feel calm and clear.',
    tools: ['Figma', 'Storybook', 'WCAG Accessibility', 'User Testing', 'Design Systems'],
  },
];
---

<section class="skills-grid">
  {
    skillsData.map(skill => (
      <div class="skill-card">
        <div class="icon-wrapper">
          <Icon icon={skill.icon} color="var(--accent-regular)" size="2.5rem" gradient />
        </div>
        <h2 set:html={skill.title} />
        <p>{skill.description}</p>
        <ul class="tech-list" role="list">
          {skill.tools.map(tool => (
            <li>{tool}</li>
          ))}
        </ul>
      </div>
    ))
  }
</section>

<style>
  .skills-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Content used to live on two faces that cross-faded on hover. That put the whole tech list
     behind `visibility: hidden` on a non-focusable div — unreachable by keyboard and on touch,
     and absent from the accessibility tree. One face, everything visible. */
  .skill-card {
    display: grid;
    align-content: start;
    gap: 1rem;
    border: 1px solid var(--gray-800);
    border-radius: 1.5rem;
    padding: 2rem;
    background-color: var(--gray-999_40);
    box-shadow: var(--shadow-sm);
    transition:
      box-shadow 0.3s ease-out,
      transform 0.3s ease-out;
  }

  .skill-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
  }

  /* Shrink-to-fit, or the wrapper stretches the full grid column and `scale()` grows it
     symmetrically about the card's centre — which reads as the icon sliding left. */
  .icon-wrapper {
    display: flex;
    justify-self: start;
    transition: transform 0.3s ease-out;
  }

  .skill-card:hover .icon-wrapper {
    transform: scale(1.1);
  }

  h2 {
    font-size: var(--text-2xl);
    line-height: 1.1;
  }

  p {
    color: var(--gray-400);
  }

  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
    padding: 0;
    margin: 0.5rem 0 0 0;
    list-style: none;
  }

  .tech-list li {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--gray-300);
    background-color: var(--gray-800);
    padding: 0.25rem 0.75rem;
    border-radius: 999px;
  }

  @media (min-width: 50em) {
    .skills-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }
</style>
