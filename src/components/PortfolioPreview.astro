---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
---

<a class="card" href={`/work/${id}/`}>
  <div class="text-content">
    <span class="title">{data.title}</span>
    <div class="details">
      <p>{data.description}</p>
      <div class="tags">
        {data.tags.map(tag => <span class="tag">{tag}</span>)}
      </div>
    </div>
  </div>

  {/* Cropped to fill the card by `object-fit: cover`, so only the rendered width matters. */}
  <Image
    src={data.img}
    alt={data.img_alt || ''}
    widths={[400, 800, 1200]}
    sizes="(min-width: 50em) 50vw, 100vw"
    loading="lazy"
    decoding="async"
  />

  <div class="scrim"></div>
</a>

<style>
  .card {
    display: grid;
    position: relative;
    height: auto;
    min-height: 18rem;
    background: var(--gradient-subtle);
    border: 1px solid var(--gray-800);
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition:
      box-shadow 0.3s ease,
      transform 0.3s ease;
  }

  .card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    box-shadow: inset 0 0 4rem 4rem hsla(0, 0%, 0%, 0.4);
    transition: box-shadow 0.4s ease;
  }

  .card:hover,
  .card:focus-visible {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .card:hover::after,
  .card:focus-visible::after {
    box-shadow: inset 0 0 3rem 1rem hsla(0, 0%, 0%, 0.2);
  }

  img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scrim {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;

    background: linear-gradient(
      180deg,
      hsla(var(--gray-999-basis), 0) 0%,
      hsla(var(--gray-999-basis), 0.8) 50%,
      hsla(var(--gray-999-basis), 1) 100%
    );
    pointer-events: none;
  }

  .text-content {
    position: relative;
    z-index: 2;
    height: 100%;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    padding: 1rem;
    color: var(--gray-50);
  }

  .title {
    display: inline-block;
    align-self: flex-start;
    padding: 0.5rem 1rem;

    background-color: hsla(var(--gray-999-basis), 0.5);
    backdrop-filter: blur(10px);
    border: 1px solid hsla(var(--gray-999-basis), 0.1);
    color: var(--accent-text-over);
    text-shadow: 1px 1px 4px black;

    border-radius: 0.375rem;
    font-family: var(--font-brand);
    font-size: var(--text-base);
    font-weight: 500;
  }

  /* No hover below 50em, so the details have no reveal to belong to — the image and title carry
     the card, and `display: none` keeps the duplicated text out of the a11y tree too. */
  .details {
    display: none;
    color: var(--gray-300);
  }

  .scrim {
    opacity: 0;
  }

  .details p {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    margin: 0 0 0.75rem 0;
    color: var(--gray-50);
    text-shadow: 0 1px 2px hsla(var(--gray-999-basis), 0.5);

    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .tag {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    padding: 0.25rem 0.625rem;
    border-radius: 999px;

    background-color: hsla(var(--gray-0-basis), 0.2);
    backdrop-filter: blur(12px);
    border: 1px solid hsla(var(--gray-999-basis), 0.5);
    color: var(--gray-100);
  }

  @media (min-width: 50em) {
    .card {
      height: 22rem;
    }

    .details {
      display: block;
    }

    .details,
    .scrim {
      opacity: 0;
      transition: opacity 0.3s ease-in-out;
    }

    .card:hover .details,
    .card:hover .scrim,
    .card:focus-visible .details,
    .card:focus-visible .scrim {
      opacity: 1;
    }

    .title {
      font-size: var(--text-lg);
    }

    .details p {
      font-size: var(--text-md);
    }
  }
</style>
